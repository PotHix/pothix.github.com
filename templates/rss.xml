{#- Zola's built-in rss.xml, restricted to the posts section. Places and
    standalone pages are tagged and dated like posts, so every feed (site,
    section and tag) would otherwise carry them. Zola's `last_updated` is
    computed before this filtering, so the date comes from the newest post
    instead: `pages` arrives sorted newest first. -#}
{%- set_global newest_post = false -%}
{%- for page in pages -%}
  {%- if not newest_post and page.relative_path | split(pat="/") | first == "posts" -%}
    {%- set_global newest_post = page.date -%}
  {%- endif -%}
{%- endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss xmlns:atom="http://www.w3.org/2005/Atom" version="2.0">
    <channel>
      <title>{{ config.title }}
        {%- if term is defined %} - {{ term.name }}
        {%- elif section is defined and section.title %} - {{ section.title }}
        {%- endif -%}
      </title>
      <link>
        {%- if section is defined -%}
          {{ section.permalink | escape_xml | safe }}
        {%- else -%}
          {{ config.base_url | escape_xml | safe }}
        {%- endif -%}
      </link>
      <description>{{ config.description }}</description>
      <generator>Zola</generator>
      <language>{{ lang }}</language>
      <atom:link href="{{ feed_url | safe }}" rel="self" type="application/rss+xml"/>
      {% if newest_post %}<lastBuildDate>{{ newest_post | date(format="%a, %d %b %Y %H:%M:%S %z") }}</lastBuildDate>{% endif %}
      {%- for page in pages %}
      {%- if page.relative_path | split(pat="/") | first == "posts" %}
      <item>
          <title>{{ page.title }}</title>
          <pubDate>{{ page.date | date(format="%a, %d %b %Y %H:%M:%S %z") }}</pubDate>
          <author>
            {%- if page.authors -%}
              {{ page.authors[0] }}
            {%- elif config.author -%}
              {{ config.author }}
            {%- else -%}
              Unknown
            {%- endif -%}
          </author>
          <link>{{ page.permalink | escape_xml | safe }}</link>
          <guid>{{ page.permalink | escape_xml | safe }}</guid>
          <description xml:base="{{ page.permalink | escape_xml | safe }}">{% if page.summary %}{{ page.summary }}{% else %}{{ page.content }}{% endif %}</description>
      </item>
      {%- endif %}
      {%- endfor %}
    </channel>
</rss>
